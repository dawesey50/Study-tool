    "@types/jszip": "^3.4.0",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fflate": "^0.8.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38",
    "pino-pretty": "^13.1.3",
    "pngjs": "^7.0.0",
