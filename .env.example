# Copy to .env and adjust. Every value here has a working default.

# --- Server ---
PORT=5174
HOST=127.0.0.1

# --- Data locations (relative paths resolve against the repo root) ---
DATA_DIR=./data
# The whole system is one SQLite file plus the media folder beside it.
# Back both up together.

# --- Embeddings ---
# local : transformers.js running all-MiniLM-L6-v2 on your machine (free, recommended).
#         Downloads ~90MB on first use, then works fully offline.
# hash  : deterministic offline stand-in. Lets the app run with no model download,
#         but similarity scores are meaningless. Development and CI only.
EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Where the downloaded model is cached.
MODEL_CACHE_DIR=./.models

# --- Vector index ---
# sqlite-vec : use the sqlite-vec extension for KNN (default).
# brute      : brute-force cosine in JS. Fine for a single user's data.
VECTOR_BACKEND=sqlite-vec

# --- Uploads ---
# Largest single file, in megabytes. Scanned textbooks are often several
# hundred, so raise this if one is rejected.
MAX_UPLOAD_MB=500

# --- Ingestion ---
# Target chunk size in characters, and overlap between neighbouring chunks.
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=180
# Embedded images smaller than this in either dimension are skipped as
# bullets, logos and rules rather than real figures.
FIGURE_MIN_DIMENSION=90

# --- Model providers ---
# Generation needs at least one of these. Without any, everything already
# ingested still works: search, figures and your own notes need no model.
# Each provider is skipped entirely when its key is blank, so a chain of one
# is a perfectly normal setup.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Force every task onto one provider. Mostly useful as LLM_PROVIDER=stub,
# which answers offline with no key at all — that is what the test suite uses.
LLM_PROVIDER=

# --- Which model runs which task ---
# The spec's routing table. Nothing in the code names a model, so changing one
# of these and restarting is the whole of "switch the note-generation model".
# Claude ids come from the current model list; the Gemini and Groq ids below
# are placeholders you should check against those providers' own docs before
# adding their keys, because they rename models often.
LLM_MODEL_NOTES=claude-sonnet-5
LLM_MODEL_QUESTIONS=claude-sonnet-5
LLM_MODEL_REWRITE=claude-sonnet-5
LLM_MODEL_HIERARCHY=claude-sonnet-5
LLM_MODEL_EXAMINER=claude-haiku-4-5
LLM_MODEL_CONCEPTS=gemini-2.5-flash
LLM_MODEL_TRANSCRIPT=gemini-2.5-flash
LLM_MODEL_FIGURE_CAPTION=gemini-2.5-flash

# What each provider runs when standing in for one that is down.
LLM_FALLBACK_MODEL_ANTHROPIC=claude-haiku-4-5
LLM_FALLBACK_MODEL_GEMINI=gemini-2.5-flash
LLM_FALLBACK_MODEL_GROQ=llama-3.3-70b-versatile

# --- Spending limits ---
# Three brakes, because accounting alone only tells you afterwards.
# Tokens any single job may use before it stops and says so.
LLM_MAX_TOKENS_PER_RUN=400000
# Pounds a module may cost in a calendar month. 0 turns the cap off.
LLM_MONTHLY_CAP_GBP=15
# Passes round a loop that regenerates until a condition is met — the coverage
# check is one. After this it reports what is still outstanding instead.
LLM_MAX_ITERATIONS=3

# Reuse of identical answers. Set to "off" to pay for every call.
LLM_CACHE=on

# Longest single response, and the point above which responses are streamed so
# a long one cannot hit the request timeout.
LLM_MAX_OUTPUT_TOKENS=8000
LLM_STREAM_ABOVE_TOKENS=8000
LLM_TIMEOUT_MS=120000

# Display only. Bills arrive in dollars; the spec's budget is in pounds, and
# the interface says which rate it used rather than pretending it is live.
USD_TO_GBP=0.79

# --- Restore points ---
# Kept per module. One is saved automatically before anything rewrites notes in
# bulk, so this bounds how far back you can go. They hold notes only, so they
# are small. 0 turns pruning off entirely.
SNAPSHOTS_KEPT=20

# --- Concept extraction ---
# The plausibility check on a section's concept count. Every number here is a
# guess until real lecture material has been through: a slide deck is terse and
# dense in claims, a transcript is verbose and sparse in them, so no single
# ratio fits both. The band is wide on purpose — a warning that fires on
# ordinary variation is one you learn to ignore.
CONCEPT_CHARS_EACH=900
CONCEPT_PLAUSIBLE_LOW=0.2
CONCEPT_PLAUSIBLE_HIGH=4
CONCEPT_MIN_CHARS=2500

# --- Past papers ---
# How close a past-paper question has to be to a concept before it counts as
# having examined it. Too low and half the module gets flagged, which tells you
# as little as flagging none of it.
PAST_PAPER_MATCH_THRESHOLD=0.55

# --- Note generation ---
# How closely a note block has to match a concept to count as covering it. This
# one decides whether the coverage badge tells the truth: too low and the notes
# read as fully covered while concepts are only mentioned in passing.
COVERAGE_THRESHOLD=0.62
# How closely a figure's caption has to match a block to be placed beside it.
FIGURE_MATCH_THRESHOLD=0.5
NOTE_MAX_OUTPUT_TOKENS=8000
# Replaces the built-in note format wholesale. Leave blank to use the default.
NOTE_FORMAT=
