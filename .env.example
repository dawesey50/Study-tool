# Copy to .env and adjust. Every value here has a working default.

# --- Server ---
PORT=5174
HOST=127.0.0.1

# --- Data locations (relative paths resolve against the repo root) ---
DATA_DIR=./data
# The whole system is one SQLite file plus the media folder beside it.
# Back both up together.

# --- Embeddings ---
# local : transformers.js running all-MiniLM-L6-v2 on your machine (free, recommended).
#         Downloads ~90MB on first use, then works fully offline.
# hash  : deterministic offline stand-in. Lets the app run with no model download,
#         but similarity scores are meaningless. Development and CI only.
EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# Where the downloaded model is cached.
MODEL_CACHE_DIR=./.models

# --- Vector index ---
# sqlite-vec : use the sqlite-vec extension for KNN (default).
# brute      : brute-force cosine in JS. Fine for a single user's data.
VECTOR_BACKEND=sqlite-vec

# --- Ingestion ---
# Target chunk size in characters, and overlap between neighbouring chunks.
CHUNK_TARGET_CHARS=1400
CHUNK_OVERLAP_CHARS=180
# Embedded images smaller than this in either dimension are skipped as
# bullets, logos and rules rather than real figures.
FIGURE_MIN_DIMENSION=90

# --- Phase 2+ (not used by Phase 1; leave blank for now) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
